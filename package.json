{
  "name": "3d-star-map",
  "version": "1.2.0",
  "description": "Interactive 3D Star Map Explorer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tests/run-all-tests.js",
    "test:pathfinding": "node tests/pathfinding.test.js",
    "test:octree": "node tests/octree.test.js",
    "test:filtering": "node tests/filtering.test.js",
    "test:integration": "node tests/integration.test.js",
    "test:launch": "electron tests/launch-smoke.cjs",
    "test:launcher": "electron tests/launcher-runtime.cjs",
    "test:exploration": "node tests/exploration-math.cjs",
    "test:pipeline": "node tests/scientific-pipeline.cjs",
    "data:build": "python scripts/build_scientific_catalog.py",
    "data:check": "python scripts/build_scientific_catalog.py --check",
    "test:markers": "electron tests/marker-rendering.cjs",
    "test:assets": "node tests/offline-assets.cjs",
    "pack:win": "electron-builder --win --x64 --dir --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "author": "Logan",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "build": {
    "appId": "com.loganstarmap.explorer",
    "productName": "3D Star Map Explorer",
    "copyright": "Copyright © 2024 Logan",
    "protocols": [
      {
        "name": "Galaxy Map",
        "schemes": [
          "galaxymap"
        ]
      }
    ],
    "files": [
      "main.js",
      "index.html",
      "script.js",
      "star_details.js",
      "constellations.js",
      "AdditiveBlendShader.js",
      "style.css",
      "exploration.css",
      "data/**/*",
      "!data/pipeline/records.json",
      "ui-utilities.css",
      "visual_presets.json",
      "stars.json",
      "modules/**/*",
      "utils/**/*",
      "workers/**/*",
      "vendor/**/*",
      "tests/offline-runtime.cjs",
      "tests/interaction-runtime.js",
      "tests/exploration-runtime.js",
      "tests/scientific-runtime.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "LoganChoate",
      "repo": "3D-Star-Map"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/launcher.nsh"
    }
  }
}
